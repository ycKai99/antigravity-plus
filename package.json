{
  "name": "antigravity-plus",
  "version": "1.2.0",
  "description": "A lightweight, zero-dependency injector suite providing Quota Limits, Skill Manager, Turn Rail navigation, and Custom Fonts for Antigravity 2.0.",
  "main": "inject-limits.js",
  "scripts": {
    "inject": "node inject.js",
    "inject:all": "node inject.js --all",
    "revert": "node inject.js --revert",
    "inject:limits": "node inject-limits.js",
    "inject:skills": "node inject-skills.js",
    "inject:rail": "node inject-turn-rail.js",
    "inject:font": "node inject-font.js",
    "inject:theme:contrast": "node inject-theme-contrast.js",
    "inject:theme:white": "node inject-theme-purewhite.js",
    "inject:theme:vintage": "node inject-theme-vintage.js",
    "inject:enhancements": "node inject-enhancements.js",
    "start": "node inject.js"
  },
  "keywords": [
    "antigravity",
    "electron",
    "theme",
    "inject",
    "custom-css",
    "quota-limits",
    "gemini"
  ],
  "author": "Fei-Away",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
