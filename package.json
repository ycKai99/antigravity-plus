{
  "name": "antigravity-plus",
  "version": "3.0.1",
  "description": "A zero-dependency injector suite providing Quota Limits, Custom Fonts, Themes and Session Metrics for Antigravity 2.0.",
  "main": "inject-limits.js",
  "scripts": {
    "inject": "node inject.js",
    "inject:all": "node inject.js --all",
    "revert": "node inject.js --revert",
    "inject:limits": "node inject-limits.js",
    "inject:font": "node inject-font.js",
    "inject:theme": "node inject-theme.mjs",
    "theme:doctor": "node theme/manage.mjs doctor",
    "theme:verify": "node theme/manage.mjs verify",
    "theme:install": "node theme/manage.mjs install",
    "theme:install-fonts": "node theme/manage.mjs install-fonts",
    "theme:rollback": "node theme/manage.mjs rollback",
    "theme:uninstall": "node theme/manage.mjs uninstall",
    "test": "node --test test/*.test.mjs",
    "start": "node inject.js"
  },
  "keywords": [
    "antigravity",
    "electron",
    "theme",
    "inject",
    "custom-css",
    "quota-limits",
    "gemini"
  ],
  "author": "Fei-Away",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
